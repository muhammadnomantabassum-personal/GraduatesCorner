{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "yarn install --frozen-lockfile",
  "buildCommand": "yarn run build",
  "crons": [
    {
      "path": "/api/cron/import-phd",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/import-trainee",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/import-employer",
      "schedule": "0 9 * * *"
    }
  ]
}
